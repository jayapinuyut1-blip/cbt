# Salin file ini menjadi .env.local untuk pengembangan lokal,
# dan masukkan semua variabel ini ke Vercel Project Settings -> Environment Variables.

# 1. Dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 2. Rahasia server-only (JANGAN pernah pakai prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3. Domain email internal untuk login pakai NIS/username (tidak perlu domain asli)
NEXT_PUBLIC_CBT_EMAIL_DOMAIN=cbt.smkn3.local

# 4. Token rahasia opsional untuk halaman /setup (buat akun Admin pertama kali)
# Hapus atau ubah setelah akun Admin pertama dibuat.
CBT_SETUP_SECRET=smkn3-setup-2026

# 5. Opsional: Gemini API Key untuk fitur "Buat Soal AI" & "Koreksi Essay AI" (dari Google AI Studio)
# Mendukung multi-key backup otomatis saat key utama kena batas kuota (429) atau gangguan:
# Anda bisa isi GEMINI_API_KEY_BACKUP, GEMINI_API_KEY_2, GEMINI_API_KEY_3, atau GEMINI_API_KEYS (dipisah koma).
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
# GEMINI_API_KEY_2=
# GEMINI_API_KEYS=key1,key2,key3

# 6. Opsional (Disarankan): Cloudinary Free Tier (25 GB gratis tanpa kartu kredit)
# Jika 3 variabel ini diisi, seluruh gambar soal & logo otomatis diunggah ke Cloudinary CDN
# sehingga bucket Supabase tetap kosong & awet. Jika dikosongkan, otomatis fallback ke Supabase Storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
